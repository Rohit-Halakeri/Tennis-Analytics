# ─────────────────────────────────────────────
# Data files (too large for GitHub)
# ─────────────────────────────────────────────
data/raw/
data/*.parquet
data/*.csv
data/*.db

# Keep the pipeline report (small text file)
!data/pipeline_report.txt

# ─────────────────────────────────────────────
# Models (regeneratable, can be large)
# ─────────────────────────────────────────────
models/*.json
models/*.pkl
models/*.bin

# Keep feature names (tiny text file)
!models/feature_names.txt

# ─────────────────────────────────────────────
# Reports / generated images
# ─────────────────────────────────────────────
# Comment this out if you WANT to commit profile PNGs
# reports/*.png

